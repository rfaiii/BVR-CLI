# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# IDE specific files
.idea/
.vscode/
*.swp
*.swo

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.log

# Binary output directory
/bin/
/dist/

# Local environment variables
.env
.env.local

# Nix/direnv
.direnv/

**/.bvr/**

/bvr
/bvr-cli
/bvr-cli-*
/tmp/

manpages/
completions/bvr.*sh
completions/bvr-cli.*sh
.prettierignore
.task
.node_modules
node_modules/

# Local/experimental files
mcp-server/src/mcp_server/__pycache__/

# Internal working documents that are not published to GitHub.
# Everything that is ignored-and-markdown lives under docs/ignore/; see the
# README in that folder before promoting a document back into the published
# docs set. docs/TASKLIST.md, docs/REMOVAL.md, antigravity/rules.md and the
# root CONTEXT.md were consolidated there in 1.2.7.
docs/ignore/
CONTEXT.md
*.asd

# GGWave native build artifacts and the vendored upstream checkout.
# The upstream repo is a nested git clone (116M) and must never be committed;
# scripts/build_ggwave.sh recreates it plus these outputs.
internal/ggwave/ggwave/
internal/ggwave/include/
internal/ggwave/build/
*.a
